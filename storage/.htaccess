# Tolak akses langsung ke folder ini TANPA BERGANTUNG pada mod_rewrite
# (T-26). Lapis kedua di samping RewriteRule di .htaccess root -- folder ini
# berisi storage/logs/ (bisa memuat jejak internal aplikasi). Hanya
# memblokir akses HTTP; tidak memengaruhi PHP menulis log secara internal.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
