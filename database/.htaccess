# Tolak akses langsung ke folder ini TANPA BERGANTUNG pada mod_rewrite
# (T-26). Lapis kedua di samping RewriteRule di .htaccess root -- folder ini
# berisi schema.sql/seed.sql (struktur tabel & data dev) yang tidak boleh
# bisa diunduh langsung lewat URL.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
